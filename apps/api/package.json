{
  "name": "@magic/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --import @swc-node/register/esm-register --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@magic/contracts": "workspace:*",
    "@magic/db": "workspace:*",
    "@magic/domain": "workspace:*",
    "@magic/recon": "workspace:*",
    "@magic/security": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "bullmq": "^5.81.4",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.14.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
