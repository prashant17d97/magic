NODE_ENV=development

DATABASE_URL=postgres://magic_app:magic_app_password@localhost:5433/magic
DATABASE_URL_OWNER=postgres://magic_owner:magic_owner_password@localhost:5433/magic
# Password for the application role. Migrations create and rotate `magic_app` with it,
# and DATABASE_URL above must carry the same value.
MAGIC_APP_PASSWORD=magic_app_password
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6380

API_PORT=4000
INGEST_PORT=4001
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:4000

SESSION_SECRET=change_me_to_a_64_char_random_hex_string_before_any_deployment_ok
SERVICE_TOKEN=change_me_service_token_shared_between_web_and_api

SECRETS_PROVIDER=env
STRIPE_API_VERSION=2026-06-30
STRIPE_PLATFORM_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

EXPORT_BUCKET=magic-exports
EXPORT_URL_TTL_SECONDS=900
EXPORT_DIR=/tmp/magic-exports
# One machine in local development, so the worker and the console really do share EXPORT_DIR.
# Leave it false anywhere each service has its own filesystem — it decides whether a missing
# file is reported as expired or as storage this deployment does not have.
EXPORT_STORAGE_SHARED=true
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

WORKER_ROLE=ingest
LOG_LEVEL=info
